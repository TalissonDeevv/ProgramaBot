# =====================================================================
# Configurações do ProgramaBot
# ---------------------------------------------------------------------
# 1. Copie este arquivo e renomeie a cópia para ".env" (só isso, sem nome antes do ponto).
# 2. Preencha os valores abaixo.
# 3. NUNCA envie o arquivo .env para o GitHub nem mostre seu token em prints.
#    O .gitignore já impede que o .env seja enviado por engano.
# =====================================================================

# [OBRIGATÓRIO] Token do bot: Discord Developer Portal > sua aplicação > Bot > Reset Token
DISCORD_TOKEN=cole_seu_token_aqui

# [RECOMENDADO] ID do seu servidor de testes. Com ele, os slash commands aparecem na hora.
# Deixe vazio para registrar os comandos globalmente (pode demorar alguns minutos).
GUILD_ID=

# Prefixo dos comandos de exemplo (ex.: !ping). De 1 a 5 caracteres, sem espaços.
BOT_PREFIX=!

# ID do canal de boas-vindas. Vazio = usa o "canal de mensagens do sistema" do servidor.
WELCOME_CHANNEL_ID=

# Nível de detalhe dos logs: DEBUG, INFO, WARNING, ERROR ou CRITICAL.
LOG_LEVEL=INFO

# Caminho do banco de dados dos lembretes (relativo à pasta do projeto).
DATABASE_PATH=data/programabot.db

# Intents privilegiadas. Se usar "true", ative-as também no Developer Portal (aba Bot).
# members: necessária para boas-vindas/saída de membros.
# message_content: necessária para comandos de prefixo (!ping).
ENABLE_MEMBERS_INTENT=true
ENABLE_MESSAGE_CONTENT_INTENT=true

# Sincronizar os slash commands com o Discord ao iniciar (true/false).
SYNC_COMMANDS=true
